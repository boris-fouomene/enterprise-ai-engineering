{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engineering gate policy v1",
  "type": "object",
  "required": [
    "version",
    "gates"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "command",
          "args",
          "timeoutMs",
          "required"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "command": {
            "type": "string",
            "pattern": "\\S"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600000
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}